{
  "name": "live-markdown-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:browser": "pnpm --filter @latentic/live-markdown-core test:browser",
    "check": "pnpm build && pnpm check:api && pnpm typecheck && pnpm test && pnpm test:browser",
    "check:api": "pnpm --filter @latentic/live-markdown check:api"
  }
}
